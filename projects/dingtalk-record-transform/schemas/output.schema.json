{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "钉钉记录逐条平铺输出格式",
  "type": "array",
  "uniqueItems": false,
  "items": {
    "type": "object",
    "required": [
      "公司名",
      "企业用户名",
      "企业密码",
      "店铺",
      "站点",
      "unionId",
      "name"
    ],
    "properties": {
      "公司名": {
        "type": "string"
      },
      "企业用户名": {
        "type": "string"
      },
      "企业密码": {
        "type": "string"
      },
      "店铺": {
        "type": "string"
      },
      "站点": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": false
      },
      "unionId": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": false
      },
      "name": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": false
      }
    },
    "additionalProperties": false
  },
  "$comment": "每条非空 fields 记录对应一条输出；不合并、不去重。unionId 与 name 长度相等且按下标对应，此关系由代码和测试额外保证。"
}
